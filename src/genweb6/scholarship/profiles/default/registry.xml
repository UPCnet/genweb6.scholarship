<?xml version="1.0"?>
<registry>

  <records
    interface="Products.CMFPlone.interfaces.IBundleRegistry"
    prefix="plone.bundles/scholarship-bundle">

    <value key="enabled">True</value>
    <value key="compile">True</value>
    <value key="resources">
      <element>scholarship-main</element>
    </value>
    <value key="jscompilation" />
    <value key="csscompilation">++theme++genweb6.scholarship/stylesheets/theme-scholarship.min.css</value>

  </records>

  <!-- folder_contents (pat-structure): plone.icon.contenttype mas portal type normalizado -->
  <record name="plone.icon.contenttype/scholarship">
    <field type="plone.registry.field.TextLine">
      <title>Scholarship</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/pencil.svg</value>
  </record>

</registry>
